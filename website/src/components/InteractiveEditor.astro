---
import App from "./App.tsx";

const { starterCode, exerciseId, chapterId, codeFile } = Astro.props;

if (!exerciseId) {
  throw new Error("Missing exerciseId in frontmatter");
}
if (!starterCode) {
  throw new Error("Missing starterCode");
}
---

<div class="interactive-editor">
  <App
    client:load
    starterCode={starterCode}
    exerciseId={exerciseId}
    chapterId={chapterId}
    codeFile={codeFile}
  />
</div>
<noscript>
  <p>
    <span>ویرایشگر تعاملی به JavaScript نیاز دارد.</span>
    <a href={`/exercises-code/${chapterId}/${codeFile}`}>دریافت کد اولیه</a>
  </p>
</noscript>

<style>
  .interactive-editor {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    min-width: 0;
  }
</style>
