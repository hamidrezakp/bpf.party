---
import { darkTheme } from "../styles/theme";
import "../styles/global.css";
import BookOpen from "@lucide/astro/icons/book-open";
import Terminal from "@lucide/astro/icons/terminal";
import Logo from "../../public/logo.svg";
interface Props {
  hasCodeTabs?: boolean;
  title?: string;
  description?: string;
}
const {
  hasCodeTabs = false,
  title,
  description = "آموزش عملی eBPF؛ کد بنویسید و آن را مستقیماً در مرورگر اجرا کنید.",
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `${title} - eBPF.party` : "eBPF.party"}</title>
    <style
      is:global
      set:html={`
:root {
  --color-bg-primary: ${darkTheme.bgPrimary};
  --color-background-secondary: ${darkTheme.bgSecondary};
  --color-code-bg: ${darkTheme.codeBg};
  --color-code-fg: ${darkTheme.codeFg};
  --color-text-primary: ${darkTheme.textPrimary};
  --color-text-secondary: ${darkTheme.textSecondary};
  --color-text-highlight: ${darkTheme.textHighlight};
  --color-accent: ${darkTheme.accent};
  --color-alert-bg: ${darkTheme.alertBg};
  --color-border: ${darkTheme.border};
  --color-navbar-bg: ${darkTheme.navbarBg};
  --color-navbar-border: ${darkTheme.navbarBorder};

  --astro-code-background: var(--color-code-bg);
  --astro-code-token-function: #61afef;
  --astro-code-token-keyword: #e5c07b;
  --astro-code-foreground: #e06c75;
  --astro-code-token-constant: var(--astro-code-token-keyword);
  --astro-code-token-string-expression: #98c379;
  --astro-code-token-comment: #7d8799;

}

`}
    ></style>
  </head>
  <body class:list={[hasCodeTabs && "workspace"]}>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <nav class="navbar" aria-label="ناوبری اصلی">
      <div class="navbar-content">
        <div class="navbar-left">
          <a href="/" class="site-link" aria-label="eBPF.party — صفحهٔ اصلی">
            <Logo stroke="currentColor" class="logo" aria-hidden="true" />
            <span class="site-name" dir="ltr">eBPF.party</span>
          </a>
        </div>
        {
          hasCodeTabs && (
            <div class="navbar-tabs" aria-label="نمای تمرین">
              <button
                type="button"
                data-view="instructions"
                aria-controls="exercise-instructions"
                aria-pressed="true"
                class="tab-toggle"
              >
                <BookOpen size={18} aria-hidden="true" />
                <span>راهنما</span>
              </button>
              <button
                type="button"
                data-view="code"
                aria-controls="exercise-editor"
                aria-pressed="false"
                class="tab-toggle"
              >
                <Terminal size={18} aria-hidden="true" />
                <span>کد</span>
              </button>
            </div>
          )
        }
      </div>
    </nav>
    <main id="main-content" class="app-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<script>
  const container = document.querySelector<HTMLElement>(".exercise-container");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-toggle");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!container) return;
      container.dataset.view = button.dataset.view;
      buttons.forEach((tab) =>
        tab.setAttribute("aria-pressed", String(tab === button)),
      );
    });
  });
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  .navbar {
    z-index: 1;
    border-bottom: 1px solid var(--color-navbar-border);
    background-color: var(--color-navbar-bg);
  }

  .navbar-content {
    max-width: 220ch;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 2rem;
    box-sizing: border-box;
    height: 64px;
  }

  .site-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-accent);
  }

  .logo {
    height: 1.5rem;
    width: auto;
  }

  .site-name {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .navbar-tabs {
    display: none;
  }

  .app-content {
    max-width: 220ch;
    margin: 0 auto;
    min-width: 0;
  }

  :global(.workspace) .app-content {
    height: calc(100dvh - 64px);
    min-height: 400px;
  }

  .skip-link {
    position: fixed;
    inset-block-start: 0.5rem;
    inset-inline-start: 1rem;
    transform: translateY(-150%);
    padding: 0.5rem 1rem;
    background: var(--color-code-bg);
    color: var(--color-text-primary);
    border-radius: 6px;
    z-index: 10;
  }
  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 1366px) {
    .navbar-content {
      padding-inline: 1rem;
    }
    .navbar-tabs {
      display: flex;
      gap: 0;
      background: #111;
      border-radius: 6px;
      padding: 3px;
    }

    .tab-toggle {
      cursor: pointer;
      font-size: 1.25rem;
      padding: 0.35rem 0.6rem;
      border-radius: 4px;
      background: transparent;
      transition: all 0.2s;
      user-select: none;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
    }

    .tab-toggle[aria-pressed="true"] {
      background: var(--color-accent);
      color: var(--color-bg-primary);
    }

    .tab-toggle:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .tab-toggle[aria-pressed="true"]:hover {
      background: var(--color-accent);
    }
    .tab-toggle {
      gap: 0.35rem;
      font-size: 0.875rem;
      min-height: 40px;
    }
  }
</style>
