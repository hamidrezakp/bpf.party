---
import { darkTheme } from "../styles/theme";
import "../styles/global.css";
import BookOpen from "@lucide/astro/icons/book-open";
import Terminal from "@lucide/astro/icons/terminal";
import Logo from "../../public/logo.svg";
interface Props {
  hasCodeTabs?: boolean;
  title?: string;
  description?: string;
}
const {
  hasCodeTabs = false,
  title,
  description = "آموزش عملی eBPF؛ کد بنویسید و آن را مستقیماً در مرورگر اجرا کنید.",
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `${title} - BPFLab` : "BPFLab"}</title>
    <style
      is:global
      set:html={`
:root {
  --color-bg-primary: ${darkTheme.bgPrimary};
  --color-background-secondary: ${darkTheme.bgSecondary};
  --color-code-bg: ${darkTheme.codeBg};
  --color-code-fg: ${darkTheme.codeFg};
  --color-text-primary: ${darkTheme.textPrimary};
  --color-text-secondary: ${darkTheme.textSecondary};
  --color-text-highlight: ${darkTheme.textHighlight};
  --color-accent: ${darkTheme.accent};
  --color-accent-2: ${darkTheme.accent2};
  --color-alert-bg: ${darkTheme.alertBg};
  --color-border: ${darkTheme.border};
  --color-navbar-bg: ${darkTheme.navbarBg};
  --color-navbar-border: ${darkTheme.navbarBorder};

  --gradient-accent: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-bg-strong: rgba(255, 255, 255, 0.09);
  --glass-border: rgba(255, 255, 255, 0.1);

  --astro-code-background: var(--color-code-bg);
  --astro-code-token-function: #61afef;
  --astro-code-token-keyword: #e5c07b;
  --astro-code-foreground: #e06c75;
  --astro-code-token-constant: var(--astro-code-token-keyword);
  --astro-code-token-string-expression: #98c379;
  --astro-code-token-comment: #7d8799;

}

`}
    ></style>
  </head>
  <body class:list={[hasCodeTabs && "workspace"]}>
    <a class="skip-link" href="#main-content">
      رفتن به محتوای اصلی
    </a>
    <nav class="navbar" aria-label="ناوبری اصلی">
      <div class="navbar-content">
        <div class="navbar-left">
          <a href="/" class="site-link" aria-label="BPFLab — صفحهٔ اصلی">
            <Logo stroke="currentColor" class="logo" aria-hidden="true" />
            <span class="site-name" dir="ltr">
              BPFLab
            </span>
          </a>
          <div class="navbar-links">
            <a href="/exercises/" class="nav-link">
              تمرین‌ها
            </a>
            <a href="https://blog.bpflab.ir/" class="nav-link">
              وبلاگ
            </a>
          </div>
        </div>
        {hasCodeTabs && (
          <div class="navbar-tabs" aria-label="نمای تمرین">
            <button
              type="button"
              data-view="instructions"
              aria-controls="exercise-instructions"
              aria-pressed="true"
              class="tab-toggle"
            >
              <BookOpen size={18} aria-hidden="true" />
              <span>راهنما</span>
            </button>
            <button
              type="button"
              data-view="code"
              aria-controls="exercise-editor"
              aria-pressed="false"
              class="tab-toggle"
            >
              <Terminal size={18} aria-hidden="true" />
              <span>کد</span>
            </button>
          </div>
        )}
      </div>
    </nav>
    <main id="main-content" class="app-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<script>
  const container = document.querySelector<HTMLElement>(".exercise-container");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-toggle");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!container) return;
      container.dataset.view = button.dataset.view;
      buttons.forEach((tab) =>
        tab.setAttribute("aria-pressed", String(tab === button)),
      );
    });
  });
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  .navbar {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-navbar-border);
    background-color: var(--color-navbar-bg);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  .navbar-content {
    max-width: 220ch;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 2rem;
    box-sizing: border-box;
    height: 64px;
  }

  .site-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-accent);
  }

  .navbar-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }

  .logo {
    height: 1.5rem;
    width: auto;
    filter: drop-shadow(
      0 0 14px color-mix(in srgb, var(--color-accent) 40%, transparent)
    );
  }

  .site-name {
    font-weight: 700;
    font-size: 1.15rem;
    background: linear-gradient(
      120deg,
      #f0f5ff,
      var(--color-accent) 55%,
      var(--color-accent-2)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    border: 1px solid transparent;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: var(--glass-bg);
    border-color: var(--glass-border);
  }

  .navbar-tabs {
    display: none;
  }

  .app-content {
    max-width: 220ch;
    margin: 0 auto;
    min-width: 0;
  }

  :global(.workspace) .app-content {
    height: calc(100dvh - 64px);
    min-height: 400px;
  }

  .skip-link {
    position: fixed;
    inset-block-start: 0.5rem;
    inset-inline-start: 1rem;
    transform: translateY(-150%);
    padding: 0.5rem 1rem;
    background: rgba(16, 21, 34, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--glass-border);
    color: var(--color-text-primary);
    border-radius: 999px;
    z-index: 10;
  }
  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 1366px) {
    .navbar-content {
      padding-inline: 1rem;
    }
    .navbar-tabs {
      display: flex;
      gap: 0;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-radius: 999px;
      padding: 4px;
    }

    .tab-toggle {
      cursor: pointer;
      font-size: 1.25rem;
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      background: transparent;
      transition: all 0.2s;
      user-select: none;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-secondary);
    }

    .tab-toggle[aria-pressed="true"] {
      background: var(--gradient-accent);
      color: #fff;
      box-shadow: 0 2px 14px
        color-mix(in srgb, var(--color-accent) 35%, transparent);
    }

    .tab-toggle:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-text-primary);
    }

    .tab-toggle[aria-pressed="true"]:hover {
      background: var(--gradient-accent);
      color: #fff;
    }
    .tab-toggle {
      gap: 0.35rem;
      font-size: 0.875rem;
      min-height: 40px;
    }
  }

  @media (max-width: 600px) {
    .navbar-content {
      height: auto;
      min-height: 64px;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .navbar-left {
      gap: 0.6rem;
    }

    .nav-link {
      padding: 0.45rem 0.6rem;
    }
  }
</style>
