---
import Layout from "./Layout.astro";
import InteractiveEditor from "../components/InteractiveEditor.astro";
import ExerciseNav from "../components/ExerciseNav";
import MarkCompleted from "../components/MarkCompleted";
import "../styles/mdx-content.css";

interface Props {
  chapterTitle: string;
  exerciseTitle: string;
  exerciseId: string;
  chapterId: number;
  codeFile?: string;
  hasCode: boolean;
  starterCode: string | null;
  prevExercise: { url: string; frontmatter: { title: string } } | null;
  nextExercise: {
    url: string;
    frontmatter: { title: string };
    incomplete?: boolean;
  } | null;
}

const {
  chapterTitle,
  exerciseTitle,
  exerciseId,
  chapterId,
  codeFile,
  hasCode,
  starterCode,
  prevExercise,
  nextExercise,
} = Astro.props;
---

<Layout hasCodeTabs={hasCode} title={exerciseTitle}>
  <div class="exercise-container" data-view="instructions">
    {hasCode && (
      <>
        <section
          id="exercise-instructions"
          class="content tab-content"
          aria-label="راهنمای تمرین"
        >
          <div
            class="content-scroll prose prose-invert max-w-none"
            dir="rtl"
            lang="fa"
          >
            <div class="content-body">
              <p class="chapter-title">{chapterTitle}</p>
              <h1>{exerciseTitle}</h1>
              <slot />
            </div>
            <ExerciseNav
              prevExercise={prevExercise}
              nextExercise={nextExercise}
            />
          </div>
        </section>
        <section
          id="exercise-editor"
          class="editor-wrapper tab-content"
          aria-label="ویرایشگر کد"
        >
          <InteractiveEditor
            starterCode={starterCode}
            exerciseId={exerciseId}
            chapterId={chapterId}
            codeFile={codeFile}
          />
        </section>
      </>
    )}

    {!hasCode && (
      <div class="content nocode">
        <div
          class="content-scroll prose prose-invert max-w-none"
          dir="rtl"
          lang="fa"
        >
          <div class="content-body">
            <p class="chapter-title">{chapterTitle}</p>
            <h1>{exerciseTitle}</h1>
            <slot />
          </div>
          <ExerciseNav
            prevExercise={prevExercise}
            nextExercise={nextExercise}
          />
          <MarkCompleted exerciseId={exerciseId} client:load />
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  const UA = window.navigator.userAgent;
  const isMac = /Macintosh|Mac OS|iPhone|iPad|iPod/.test(UA);
  if (isMac) {
    let ctrlKbd = Array.from(document.querySelectorAll("kbd")).filter(
      (x) => x.innerText == "Ctrl",
    );
    ctrlKbd.forEach((x) => (x.innerText = "Cmd"));
  }
</script>
<style>
  .chapter-title,
  h1 {
    padding: 0px;
    margin: 0.2em 0px 0px 0px;
    line-height: 1.5;
  }
  .chapter-title {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    padding-top: 1rem;
  }
  h1 {
    font-size: 30px;
  }

  .exercise-container {
    display: flex;
    height: 100%;
    min-width: 0;
  }

  .content {
    flex: 1;
    overflow-y: auto;
    background: transparent;
    color: var(--color-text-primary);
    max-width: 100ch;
    margin: 0px auto;
    min-width: 0;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }
  .content-scroll {
    padding: 0.5rem clamp(1rem, 3vw, 2rem) 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    box-sizing: border-box;
  }

  .exercise-container:has(.content.nocode) {
    height: auto;
  }

  .content.nocode {
    width: 100%;
    max-width: 100ch;
    margin: 0px auto;
  }

  .editor-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-inline-start: 1px solid var(--color-border);
  }
  @media (max-width: 1366px) {
    .tab-content {
      display: none;
    }

    .exercise-container[data-view="instructions"] .content.tab-content {
      display: block;
      flex: 1;
    }

    .exercise-container[data-view="code"] .editor-wrapper.tab-content {
      display: flex;
      flex: 1;
    }

    .content {
      flex: none;
      overflow-y: auto;
    }

    .content-scroll {
      max-width: 100%;
    }
  }
</style>
