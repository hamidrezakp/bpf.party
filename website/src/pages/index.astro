---
import Layout from "../layouts/Layout.astro";
import { CONTENT_METADATA } from "../lib/exercises-metadata";
import ExerciseList from "../components/ExerciseList";
---

<Layout title="آموزش عملی eBPF">
  <div class="home">
    <div class="content">
      <header class="hero">
        <p class="eyebrow">
          <span class="pulse" aria-hidden="true"></span>
          از مفاهیم تا کد واقعی
        </p>
        <h1>eBPF را با تمرین یاد بگیرید</h1>
        <p class="intro">
          کد بنویسید، کامپایل کنید و برنامه‌های eBPF را مستقیماً در مرورگر اجرا
          کنید؛ قدم‌به‌قدم با رفتار هستهٔ لینوکس آشنا شوید.
        </p>
        <a class="start-link" href="/exercises/chapter-0/1_theory/"
          >شروع یادگیری <span aria-hidden="true">←</span></a
        >
      </header>

      <ExerciseList client:idle metadata={CONTENT_METADATA} />
    </div>
    <footer class="footer">
      <p>
        مشکلی پیدا کردید یا ایده‌ای برای تمرین جدید دارید؟ آن را در <a
          href="https://github.com/DavidVentura/ebpf.party/issues">مخزن پروژه</a
        > مطرح کنید.
      </p>
      <p>
        این پروژه متن‌باز است. <a
          href="https://github.com/DavidVentura/ebpf.party"
          >کد و معماری پروژه را ببینید.</a
        >
      </p>
    </footer>
  </div>
</Layout>

<style>
  .home {
    padding: clamp(1rem, 4vw, 3rem);
    max-width: 90ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 64px);
    justify-content: space-between;
  }

  .home h1 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    line-height: 1.5;
    margin: 0 0 1rem;
    background: linear-gradient(120deg, #f4f7ff 30%, var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .home p {
    margin-bottom: 1rem;
  }
  a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-accent) 50%,
      transparent
    );
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  a:hover {
    color: var(--color-accent);
  }
  .hero {
    padding-block: 2rem 3rem;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .intro {
    color: var(--color-text-secondary);
    max-width: 60ch;
    font-size: 1.05rem;
  }
  .start-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.75rem;
    background: var(--gradient-accent);
    color: #fff;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 700;
    box-shadow: 0 6px 28px color-mix(in srgb, var(--color-accent) 35%, transparent);
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      filter 0.2s;
  }
  .start-link:hover {
    color: #fff;
    filter: brightness(1.08);
    transform: translateY(-2px);
    box-shadow: 0 10px 36px
      color-mix(in srgb, var(--color-accent) 50%, transparent);
  }
  .footer {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(2, 6, 16, 0.35);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  .footer p {
    margin: 0 0 0.75rem;
  }
  .footer p:last-child {
    margin-bottom: 0;
  }
</style>
