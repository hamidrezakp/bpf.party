---
import Layout from "../layouts/Layout.astro";
import { CONTENT_METADATA } from "../lib/exercises-metadata";
import ExerciseList from "../components/ExerciseList";
---

<Layout title="آموزش عملی eBPF">
  <div class="home">
    <div class="content">
      <header class="hero">
        <p class="eyebrow">از مفاهیم تا کد واقعی</p>
        <h1>eBPF را با تمرین یاد بگیرید</h1>
        <p class="intro">
          کد بنویسید، کامپایل کنید و برنامه‌های eBPF را مستقیماً در مرورگر اجرا
          کنید؛ قدم‌به‌قدم با رفتار هستهٔ لینوکس آشنا شوید.
        </p>
        <a class="start-link" href="/exercises/chapter-0/1_theory/"
          >شروع یادگیری <span aria-hidden="true">←</span></a
        >
      </header>

      <ExerciseList client:idle metadata={CONTENT_METADATA} />
    </div>
    <footer class="footer">
      <hr />
      <p>
        مشکلی پیدا کردید یا ایده‌ای برای تمرین جدید دارید؟ آن را در <a
          href="https://github.com/DavidVentura/ebpf.party/issues">مخزن پروژه</a
        > مطرح کنید.
      </p>
      <p>
        این پروژه متن‌باز است. <a
          href="https://github.com/DavidVentura/ebpf.party"
          >کد و معماری پروژه را ببینید.</a
        >
      </p>
    </footer>
  </div>
</Layout>

<style>
  .home {
    padding: clamp(1rem, 4vw, 3rem);
    max-width: 90ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 64px);
    justify-content: space-between;
  }

  .home h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.5;
    margin: 0 0 1rem;
    color: var(--color-text-primary);
  }

  .home p {
    margin-bottom: 1rem;
  }
  a {
    color: var(--color-text-primary);
    text-decoration: underline;
  }
  hr {
    border-color: var(--color-border);
    margin-bottom: 1em;
  }
  .hero {
    padding-block: 1rem 3rem;
  }
  .eyebrow {
    color: var(--color-accent);
    font-size: 0.875rem;
  }
  .intro {
    color: var(--color-text-secondary);
    max-width: 60ch;
  }
  .start-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1.25rem;
    background: var(--color-accent);
    color: var(--color-bg-primary);
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
  }
  .footer {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
</style>
