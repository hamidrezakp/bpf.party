# BPFLab — Docker Compose configuration.
# Copy to `.env` next to docker-compose.yml; Compose reads it automatically.
# Every variable is optional and falls back to the default shown. The website
# has its own website/.env.example (Astro); the backend reads config.toml and
# the blog reads blog/_config.yml — see README "Environment variables".

# ---- backend service -------------------------------------------------------
# Host loopback port the containerized backend is published on. The Astro dev
# server's API base (http://localhost:8081) must match: if you change this,
# set PUBLIC_API_BASE_URL in website/.env accordingly.
BACKEND_PORT=8081

# 2-MiB hugepages the backend entrypoint allocates at startup when the host
# has fewer: ceil(max_concurrent_vms x 64 MiB / 2 MiB). 128 matches the
# image's max_concurrent_vms = 4; changing the VM count itself requires
# editing docker/config.toml and rebuilding the image.
REQUIRED_HUGEPAGES=128

# Build-time versions for the backend image. KERNEL_VERSION must stay
# compatible with verifier-provenance.patch and backend/includes/task.h.
FC_VERSION=v1.16.1
KERNEL_VERSION=6.18.2

# ---- web service -----------------------------------------------------------
# Host port for the static website; nginx inside the container listens on 8080.
WEB_PORT=8080

# ---- blog service ----------------------------------------------------------
# Host port for the blog container; 4000 matches `make blog-dev`.
BLOG_PORT=4000
