# BPFLab — Docker Compose configuration.
# Copy to `.env` next to docker-compose.yml; Compose reads it automatically.
# Every variable is optional and falls back to the default shown. All services
# use host networking: these change actual listening ports, not Docker port
# bindings. Use distinct, unused ports (preferably >=1024 for nginx).
# Runtime variables also work with `docker run --network host -e KEY=VALUE`.
# The website has its own website/.env.example for Astro development/builds.

# ---- backend service -------------------------------------------------------
# Actual backend HTTP port (container default bind address: 127.0.0.1). The Astro dev
# server's API base (http://localhost:8081) must match: if you change this,
# set PUBLIC_API_BASE_URL in website/.env accordingly.
BACKEND_PORT=8081

# 2-MiB hugepages the backend entrypoint allocates at startup when the host
# has fewer: ceil(max_concurrent_vms x 64 MiB / 2 MiB). 128 matches the
# image's max_concurrent_vms = 4; changing the VM count itself requires
# editing docker/config.toml and rebuilding the image.
REQUIRED_HUGEPAGES=128

# Build-time versions for the backend image. KERNEL_VERSION must stay
# compatible with verifier-provenance.patch and backend/includes/task.h.
FC_VERSION=v1.16.1
KERNEL_VERSION=6.18.2

# ---- web service -----------------------------------------------------------
# Actual nginx listening port for the static website.
WEB_PORT=8080

# Backend address used by the web nginx proxy. Loopback works with host
# networking; BACKEND_PORT above is passed to both backend and web.
BACKEND_HOST=127.0.0.1

# ---- blog service ----------------------------------------------------------
# Actual nginx listening port for the blog; 4000 matches `make blog-dev`.
BLOG_PORT=4000
