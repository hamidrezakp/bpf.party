root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,c,h}]
indent_size = 4

[Makefile]
indent_style = tab

# Markdown: trailing spaces are hard line breaks
[*.{md,mdx}]
trim_trailing_whitespace = false

# Verbatim fixtures and diffs: whitespace is part of the content
[*.{golden,rendered,patch}]
insert_final_newline = false
trim_trailing_whitespace = false
