# syntax=docker/dockerfile:1.7

ARG FC_VERSION=v1.16.1
ARG KERNEL_VERSION=6.18.2

FROM rust:1.89-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bc bison clang curl ca-certificates flex gcc git libelf-dev libssl-dev \
      llvm make musl-tools patch pkg-config python3 rsync xz-utils e2fsprogs autopoint \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-musl
WORKDIR /build
COPY shared ./shared
COPY bins ./bins
COPY userspace ./userspace
COPY userspace/Cargo.lock ./userspace/Cargo.lock
COPY backend ./backend
COPY Makefile ./Makefile
COPY .cargo ./.cargo
COPY docker/firecracker-spawn.Cargo.toml ./docker/firecracker-spawn.Cargo.toml
COPY scripts/setup-firecracker-spawn.sh ./scripts/setup-firecracker-spawn.sh
COPY scripts/patch-firecracker.sh ./scripts/patch-firecracker.sh
COPY scripts/patch-firecracker-spawn.sh ./scripts/patch-firecracker-spawn.sh
RUN bash scripts/setup-firecracker-spawn.sh
RUN mkdir -p /tmp/nolibc \
    && curl -fsSL https://github.com/torvalds/linux/archive/refs/tags/v6.18.tar.gz \
      | tar -xzf - -C /tmp/nolibc --strip-components=4 linux-6.18/tools/include/nolibc
ENV NOLIBC_INCLUDE=/tmp/nolibc
RUN make rootfs.ext4
RUN cd userspace \
    && LIBBPF_SYS_EXTRA_CFLAGS="-idirafter /usr/include/x86_64-linux-gnu -idirafter /usr/include" \
      cargo build --release --target x86_64-unknown-linux-musl
RUN cd backend && cargo build --release

FROM debian:bookworm-slim AS kernel
ARG KERNEL_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bc bison curl ca-certificates flex gcc libelf-dev libssl-dev \
      make patch python3 rsync xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build/repo
COPY verifier-provenance.patch ./
COPY docker/bpf-party-kernel.fragment docker/
COPY scripts/build-vmlinux.sh scripts/
RUN chmod +x scripts/build-vmlinux.sh
ENV ROOT=/build/repo \
    BUILD_DIR=/build/kernel-tree \
    OUTPUT=/build/vmlinux \
    KERNEL_VERSION=${KERNEL_VERSION}
RUN ./scripts/build-vmlinux.sh

FROM debian:bookworm-slim AS runtime
ARG FC_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates clang curl \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-firecracker.sh /tmp/install-firecracker.sh
RUN chmod +x /tmp/install-firecracker.sh \
    && FC_VERSION="${FC_VERSION}" /tmp/install-firecracker.sh \
    && rm /tmp/install-firecracker.sh
WORKDIR /app
COPY --from=kernel /build/vmlinux /app/vmlinux
COPY --from=builder /build/backend/target/release/backend /usr/local/bin/backend
COPY --from=builder /build/rootfs.ext4 /app/rootfs.ext4
COPY backend/includes /app/includes
COPY docker/config.toml /app/config.toml
COPY docker/entrypoint-backend.sh /app/entrypoint-backend.sh
RUN chmod +x /app/entrypoint-backend.sh
EXPOSE 8081
ENTRYPOINT ["/app/entrypoint-backend.sh"]
