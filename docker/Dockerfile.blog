# syntax=docker/dockerfile:1.7

ARG RUBY_VERSION=3.4-slim-bookworm
ARG NGINX_VERSION=1.30-alpine

# ---------------------------------------------------------------------------
# builder: locked gems, production build, and the blog test suite
# ---------------------------------------------------------------------------
FROM ruby:${RUBY_VERSION} AS blog-build

# eventmachine (and on some platforms http_parser.rb) compile C extensions;
# everything else in the lockfile (ffi, google-protobuf, sass-embedded) ships
# prebuilt linux-gnu binaries.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
  && apt-get install -y --no-install-recommends build-essential

WORKDIR /src

# Manifests first so this layer is cached across content-only edits.
COPY blog/Gemfile blog/Gemfile.lock ./
# Run with the exact Bundler that generated the lockfile (BUNDLED WITH), so
# dependency resolution stays reproducible.
RUN gem install --no-document \
      "bundler:$(awk '/^BUNDLED WITH/{getline; print $1}' Gemfile.lock)"
ENV BUNDLE_FROZEN=true \
    BUNDLE_SILENCE_ROOT_WARNING=1 \
    # Liquid 4 emits hundreds of frozen-string-literal deprecation warnings
    # on Ruby 3.4; they are fixed upstream, so keep them out of build logs.
    RUBYOPT=-W:no-deprecated
RUN bundle install

COPY blog/ ./

# Same gates as `make blog-check`: production build with strict front matter,
# helper/generated-site tests, then jekyll doctor. The plugin must load, so
# never build with --safe.
RUN JEKYLL_ENV=production bundle exec jekyll build --strict_front_matter
RUN bundle exec ruby -Itest test/blog_test.rb
RUN bundle exec jekyll doctor

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:${NGINX_VERSION} AS runtime
ENV BLOG_PORT=4000 \
    NGINX_ENVSUBST_FILTER="^BLOG_PORT$"
COPY --chown=101:101 docker/nginx.blog.conf /etc/nginx/templates/default.conf.template
COPY --from=blog-build --chown=101:101 /src/_site /usr/share/nginx/html
USER 101:101
EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${BLOG_PORT}/healthz" || exit 1
