# syntax=docker/dockerfile:1.7

ARG EMSDK_VERSION=3.1.56
ARG NODE_VERSION=22-bookworm-slim
ARG NGINX_VERSION=1.30-alpine

FROM emscripten/emsdk:${EMSDK_VERSION} AS tcc
RUN apt-get update && apt-get install -y --no-install-recommends clang gcc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY backend/includes ./backend/includes
COPY tcc ./tcc
RUN ln -sfn ../backend/includes tcc/em_include \
    && cd backend/includes \
    && clang -g -fpch-debuginfo -O2 -target bpf -x c-header task.h -o task.h.pch \
    && cd /build/tcc \
    && ./configure \
    && EMCC_CFLAGS="-sINCOMING_MODULE_JS_API=locateFile,print,printErr,preRun" bash embuild.sh

FROM node:${NODE_VERSION} AS website-build
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    ASTRO_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app
COPY website/package.json website/pnpm-lock.yaml website/pnpm-workspace.yaml website/.npmrc ./
RUN --mount=type=cache,id=website-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store
COPY website/ ./
COPY --from=tcc /build/tcc/syntax_check.mjs ./src/wasm/syntax_check.mjs
COPY --from=tcc /build/tcc/syntax_check.data ./public/tcc/syntax_check.data
COPY --from=tcc /build/tcc/syntax_check.wasm ./public/tcc/syntax_check.wasm
RUN pnpm check && pnpm test && pnpm build

FROM nginxinc/nginx-unprivileged:${NGINX_VERSION} AS runtime
COPY --chown=101:101 docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=website-build --chown=101:101 /app/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
