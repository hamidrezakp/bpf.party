# syntax=docker/dockerfile:1.7

FROM emscripten/emsdk:3.1.56 AS tcc
RUN apt-get update && apt-get install -y --no-install-recommends clang gcc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY backend/includes ./backend/includes
COPY tcc ./tcc
RUN ln -sfn ../backend/includes tcc/em_include \
    && cd backend/includes \
    && clang -g -fpch-debuginfo -O2 -target bpf -x c-header task.h -o task.h.pch \
    && cd /build/tcc \
    && ./configure \
    && bash embuild.sh

FROM node:20-bookworm-slim AS website-build
RUN corepack enable
WORKDIR /app
COPY website/package.json website/pnpm-lock.yaml website/pnpm-workspace.yaml website/.npmrc ./
RUN pnpm install --frozen-lockfile
COPY website/ ./
COPY --from=tcc /build/tcc/syntax_check.mjs ./src/wasm/syntax_check.mjs
COPY --from=tcc /build/tcc/syntax_check.data ./public/tcc/syntax_check.data
RUN ./node_modules/.bin/astro build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=website-build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
